# --- Server-backed deployments (Vercel / Docker / VPS) ---
# Postgres connection string. NEVER commit the real value.
DATABASE_URL=postgresql://user:password@host:5432/app_db

# --- Public (safe to expose in the browser bundle) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_ALLOW_INDEXING=0

# --- Static export only (GitHub Pages / Cloudflare Pages) ---
# NEXT_PUBLIC_STATIC_EXPORT=1
# NEXT_PUBLIC_BASE_PATH=/repo-name
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxx
